<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RootNamespace>EveLens.Common</RootNamespace>
    <AssemblyName>EveLens.Infrastructure</AssemblyName>
    <DefineConstants>$(DefineConstants);NO_THREAD_SAFETY</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- MailKit removed: this assembly never used it (email/SMTP lives in EveLens.Common). -->
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EveLens.Core\EveLens.Core.csproj" />
    <ProjectReference Include="..\EveLens.Data\EveLens.Data.csproj" />
    <ProjectReference Include="..\EveLens.Serialization\EveLens.Serialization.csproj" />
    <ProjectReference Include="..\EveLens.Models\EveLens.Models.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\SharedAssemblyInfo.cs" Link="Properties\SharedAssemblyInfo.cs" />
  </ItemGroup>

</Project>
