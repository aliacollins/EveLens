<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:EveLens.Avalonia.Markup"
        x:Class="EveLens.Avalonia.Views.Dialogs.DiagnosticStreamWindow"
        Title="{loc:T Diag.Title}"
        Width="800" Height="500"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource EveBackgroundDarkBrush}">

    <DockPanel Margin="0">
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Padding="8,5"
                Background="{StaticResource EveBackgroundMediumBrush}"
                BorderBrush="{StaticResource EveBorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{loc:T ListView.Filter}" FontSize="{DynamicResource EveFontBody}" VerticalAlignment="Center"
                           Foreground="{StaticResource EveTextSecondaryBrush}" />
                <ComboBox x:Name="FilterCombo" FontSize="{DynamicResource EveFontBody}" MinWidth="120"
                          SelectedIndex="0">
                    <ComboBoxItem Content="{loc:T Diag.FilterAll}" />
                    <ComboBoxItem Content="{loc:T Diag.FilterEsi}" />
                    <ComboBoxItem Content="{loc:T Diag.FilterEvents}" />
                    <ComboBoxItem Content="{loc:T Diag.FilterWarnings}" />
                    <ComboBoxItem Content="{loc:T Diag.FilterHealth}" />
                    <ComboBoxItem Content="{loc:T Diag.FilterScheduler}" />
                </ComboBox>
                <Button x:Name="ClearBtn" Content="{loc:T Diag.Clear}" FontSize="{DynamicResource EveFontBody}"
                        Padding="10,3" CornerRadius="10" />
                <CheckBox x:Name="AutoScrollCheck" Content="{loc:T Diag.AutoScroll}"
                          FontSize="{DynamicResource EveFontBody}" IsChecked="True"
                          Foreground="{StaticResource EveTextSecondaryBrush}" />
                <TextBlock x:Name="LineCountText" Text="0 lines" FontSize="{DynamicResource EveFontBody}"
                           VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="{StaticResource EveTextDisabledBrush}" />
            </StackPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Padding="8,3"
                Background="{StaticResource EveBackgroundMediumBrush}"
                BorderBrush="{StaticResource EveBorderBrush}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText" Text="{loc:T Diag.Listening}" FontSize="{DynamicResource EveFontSmall}"
                       Foreground="{StaticResource EveTextDisabledBrush}" />
        </Border>

        <!-- Log output -->
        <ScrollViewer x:Name="LogScroller" Padding="6">
            <TextBlock x:Name="LogOutput" FontSize="10.5"
                       FontFamily="Consolas, Courier New, monospace"
                       Foreground="{StaticResource EveTextPrimaryBrush}"
                       TextWrapping="NoWrap" />
        </ScrollViewer>
    </DockPanel>
</Window>
