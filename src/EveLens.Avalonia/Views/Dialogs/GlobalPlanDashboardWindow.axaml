<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:EveLens.Avalonia.Markup"
        x:Class="EveLens.Avalonia.Views.Dialogs.GlobalPlanDashboardWindow"
        Title="{loc:T Doctrine.Title}"
        Icon="avares://EveLens/Properties/EveLens.ico"
        Width="1100" Height="700" MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource EveBackgroundDarkBrush}">

    <DockPanel Margin="0">
        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Height="32"
                Background="{StaticResource EveBackgroundMediumBrush}"
                BorderBrush="{StaticResource EveBorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel Margin="12,0">
                <TextBlock x:Name="StatusText" Text="{loc:T Doctrine.StatusStart}"
                           FontSize="{DynamicResource EveFontBody}"
                           Foreground="{StaticResource EveTextSecondaryBrush}"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Main content: sidebar + grid -->
        <Grid ColumnDefinitions="220,1,*">
            <!-- Left sidebar -->
            <Border Grid.Column="0" Background="{StaticResource EveBackgroundDarkBrush}">
                <DockPanel>
                    <!-- Sidebar header -->
                    <StackPanel DockPanel.Dock="Top" Margin="12,10,12,6" Spacing="8">
                        <TextBlock x:Name="DoctrinesSidebarLabel" Text="{loc:T Doctrine.Doctrines}" FontSize="{DynamicResource EveFontSubheading}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource EveAccentPrimaryBrush}" />
                        <Button x:Name="NewTemplateBtn" Content="{loc:T Doctrine.NewDoctrine}"
                                HorizontalAlignment="Stretch" Padding="8,5"
                                CornerRadius="12" FontSize="{DynamicResource EveFontBody}" />
                        <Button x:Name="ImportFromPlanBtn" Content="{loc:T Doctrine.ImportFromPlan}"
                                HorizontalAlignment="Stretch" Padding="8,5"
                                CornerRadius="12" FontSize="{DynamicResource EveFontBody}" />
                        <Button x:Name="ImportFromFileBtn" Content="{loc:T Doctrine.ImportFromFile}"
                                HorizontalAlignment="Stretch" Padding="8,5"
                                CornerRadius="12" FontSize="{DynamicResource EveFontBody}" />
                        <Button x:Name="ImportFromClipboardBtn" Content="{loc:T Doctrine.ImportFromClipboard}"
                                HorizontalAlignment="Stretch" Padding="8,5"
                                CornerRadius="12" FontSize="{DynamicResource EveFontBody}" />
                    </StackPanel>

                    <!-- Template list -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="TemplateList" Spacing="2" Margin="8,4" />
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Divider -->
            <Border Grid.Column="1" Background="{StaticResource EveBorderBrush}" />

            <!-- Right panel -->
            <Border Grid.Column="2" Background="{StaticResource EveBackgroundDarkBrush}">
                <DockPanel>
                    <!-- Toolbar -->
                    <Border DockPanel.Dock="Top" Padding="12,8"
                            Background="{StaticResource EveBackgroundMediumBrush}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                                <Button x:Name="AddSkillBtn" Content="{loc:T Action.AddSkill}"
                                        Padding="10,4" CornerRadius="12"
                                        FontSize="{DynamicResource EveFontBody}" />
                                <Button x:Name="AddCharBtn" Content="{loc:T Action.AddCharacter}"
                                        Padding="10,4" CornerRadius="12"
                                        FontSize="{DynamicResource EveFontBody}" />
                                <Button x:Name="ApplyAllBtn" Content="{loc:T Doctrine.CreatePlansForAll}"
                                        Padding="10,4" CornerRadius="12"
                                        FontSize="{DynamicResource EveFontBody}" />
                                <ToggleButton x:Name="OnlyMissingToggle" Content="{loc:T Doctrine.ShowOnlyMissing}"
                                              Padding="10,4" CornerRadius="12"
                                              FontSize="{DynamicResource EveFontBody}"
                                              IsCheckedChanged="OnOnlyMissingToggled" />
                            </StackPanel>
                            <TextBlock x:Name="TemplateTitle" Text="{loc:T Doctrine.NoTemplateSelected}"
                                       FontSize="{DynamicResource EveFontHeading}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource EveAccentPrimaryBrush}"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <!-- Comparison table with frozen panes: the skill column and the
                         header row stay on screen while the character cells scroll
                         both ways (odon, #137 follow-up). The summary cards ARE the
                         header row — one card per character column, same width as the
                         cells, so tiles and ticks cannot drift apart. The body
                         scroller owns the scrollbars; all three scrollers mirror
                         offsets both ways, since Hidden scrollbars still accept the
                         mouse wheel. -->
                    <Grid Margin="12,4" RowDefinitions="Auto,*" ColumnDefinitions="Auto,*">
                        <Grid x:Name="FrozenCorner" Grid.Row="0" Grid.Column="0" />
                        <ScrollViewer x:Name="HeaderScroller" Grid.Row="0" Grid.Column="1"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled"
                                      ScrollChanged="OnHeaderScrollChanged">
                            <StackPanel x:Name="HeaderStrip" Orientation="Horizontal" />
                        </ScrollViewer>
                        <ScrollViewer x:Name="SkillColScroller" Grid.Row="1" Grid.Column="0"
                                      VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Disabled"
                                      ScrollChanged="OnSkillColScrollChanged">
                            <StackPanel x:Name="SkillColumn" Spacing="1" />
                        </ScrollViewer>
                        <ScrollViewer x:Name="BodyScroller" Grid.Row="1" Grid.Column="1"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      ScrollChanged="OnBodyScrollChanged">
                            <StackPanel x:Name="BodyRows" Spacing="1" />
                        </ScrollViewer>
                        <TextBlock x:Name="ComparisonMessage" Grid.Row="1" Grid.Column="0"
                                   Grid.ColumnSpan="2" IsVisible="False"
                                   FontSize="{DynamicResource EveFontBody}"
                                   Foreground="{StaticResource EveTextDisabledBrush}"
                                   HorizontalAlignment="Center" Margin="0,40"
                                   TextWrapping="Wrap" TextAlignment="Center" />
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
