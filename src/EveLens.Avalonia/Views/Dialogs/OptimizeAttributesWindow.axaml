<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:EveLens.Avalonia.Markup"
        x:Class="EveLens.Avalonia.Views.Dialogs.OptimizeAttributesWindow"
        Title="{loc:T Optimizer.Title}"
        Width="820" Height="660"
        WindowStartupLocation="CenterOwner"
        Icon="avares://EveLens/Properties/EveLens.ico"
        CanResize="True">

    <DockPanel Margin="20,16">

        <!-- Header: title left, remap budget chip right -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Border DockPanel.Dock="Right" VerticalAlignment="Top"
                    Background="{DynamicResource EveBackgroundMediumBrush}"
                    CornerRadius="12" Padding="12,6">
                <TextBlock x:Name="RemapsChipText"
                           FontSize="{DynamicResource EveFontSmall}"
                           Foreground="{StaticResource EveTextSecondaryBrush}" />
            </Border>
            <StackPanel Spacing="4">
                <TextBlock Text="{loc:T Optimizer.Heading}"
                           FontSize="{DynamicResource EveFontTitle}" FontWeight="SemiBold"
                           Foreground="{StaticResource EveAccentPrimaryBrush}" />
                <TextBlock Text="{loc:T Optimizer.Subtitle}"
                           FontSize="{DynamicResource EveFontSmall}"
                           Foreground="{StaticResource EveTextSecondaryBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>

        <!-- Strategy + clone pickers on one row -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="24"
                    Margin="0,0,0,10">
            <StackPanel Spacing="4">
                <TextBlock Text="{loc:T Optimizer.Strategy}"
                           FontSize="{DynamicResource EveFontSmall}" FontWeight="SemiBold"
                           Foreground="{StaticResource EveTextSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <RadioButton x:Name="StrategyAutoPlace" GroupName="strategy" IsChecked="True"
                                 Content="{loc:T Optimizer.StrategyAutoPlace}"
                                 FontSize="{DynamicResource EveFontBody}" />
                    <RadioButton x:Name="StrategyWholePlan" GroupName="strategy"
                                 Content="{loc:T Optimizer.StrategyWholePlan}"
                                 FontSize="{DynamicResource EveFontBody}" />
                </StackPanel>
            </StackPanel>
            <StackPanel Spacing="4">
                <TextBlock Text="{loc:T Optimizer.CloneState}"
                           FontSize="{DynamicResource EveFontSmall}" FontWeight="SemiBold"
                           Foreground="{StaticResource EveTextSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <RadioButton x:Name="CloneAuto" GroupName="clone" IsChecked="True"
                                 Content="{loc:T Optimizer.CloneAuto}"
                                 FontSize="{DynamicResource EveFontBody}" />
                    <RadioButton x:Name="CloneOmega" GroupName="clone"
                                 Content="{loc:T Eve.Omega}"
                                 FontSize="{DynamicResource EveFontBody}" />
                    <RadioButton x:Name="CloneAlpha" GroupName="clone"
                                 Content="{loc:T Eve.Alpha}"
                                 FontSize="{DynamicResource EveFontBody}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- Headline: current → optimized · save · finish date -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource EveBackgroundMediumBrush}"
                CornerRadius="6" Padding="14,10" Margin="0,0,0,10">
            <StackPanel x:Name="HeadlineRow" Orientation="Horizontal" Spacing="12" />
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Padding="0,12,0,0">
            <DockPanel>
                <TextBlock Text="{loc:T Optimizer.NothingChanges}" DockPanel.Dock="Left"
                           FontSize="{DynamicResource EveFontSmall}"
                           Foreground="{StaticResource EveTextDisabledBrush}"
                           VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Content="{loc:T Action.Cancel}"
                            FontSize="{DynamicResource EveFontBody}" Padding="16,6" CornerRadius="12" />
                    <Button x:Name="ApplyButton" Content="{loc:T Optimizer.ApplyToPlan}"
                            FontSize="{DynamicResource EveFontBody}" Padding="16,6" CornerRadius="12"
                            Background="{StaticResource EveAccentPrimaryBrush}"
                            Foreground="#FF1A1A2E" FontWeight="SemiBold"
                            IsEnabled="False" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Two columns: proposed schedule timeline | remap details inspector -->
        <Grid ColumnDefinitions="*,12,330">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{loc:T Optimizer.ProposedSchedule}"
                           FontSize="{DynamicResource EveFontBody}" FontWeight="SemiBold"
                           Margin="0,0,0,6" />
                <ScrollViewer>
                    <StackPanel x:Name="ResultsPanel" Spacing="8" Margin="0,0,8,0" />
                </ScrollViewer>
            </DockPanel>
            <Border Grid.Column="2" Background="{DynamicResource EveBackgroundMediumBrush}"
                    CornerRadius="6" Padding="14,12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{loc:T Optimizer.RemapDetails}"
                               FontSize="{DynamicResource EveFontBody}" FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <ScrollViewer>
                        <StackPanel x:Name="DetailsPanel" Spacing="8" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

    </DockPanel>
</Window>
