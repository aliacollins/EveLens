<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:EveLens.Avalonia.Markup"
        x:Class="EveLens.Avalonia.Views.Dialogs.AddCharacterWindow"
        Title="{loc:T AddChar.Title}"
        Width="420" Height="420"
        WindowStartupLocation="CenterOwner"
        Icon="avares://EveLens/Properties/EveLens.ico"
        CanResize="True">

    <Grid Margin="20">
        <!-- State: Ready (initial landing) -->
        <Border x:Name="ReadyPanel" IsVisible="True">
            <StackPanel VerticalAlignment="Center" Spacing="8">
                <TextBlock Text="{loc:T AddChar.SignIn}"
                           FontSize="{DynamicResource EveFontTitle}" FontWeight="SemiBold"
                           Foreground="{StaticResource EveAccentPrimaryBrush}" />
                <TextBlock Text="{loc:T AddChar.SignInDesc}"
                           FontSize="{DynamicResource EveFontBody}"
                           Foreground="{StaticResource EveTextSecondaryBrush}"
                           TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0"
                            HorizontalAlignment="Right">
                    <Button x:Name="OpenLoginBtn"
                            Content="{loc:T AddChar.SignInBtn}"
                            FontSize="{DynamicResource EveFontBody}" Padding="14,6"
                            CornerRadius="12"
                            Foreground="{StaticResource EveAccentPrimaryBrush}" />
                    <Button x:Name="CancelReadyBtn"
                            Content="{loc:T Action.Cancel}"
                            FontSize="{DynamicResource EveFontBody}" Padding="14,6"
                            CornerRadius="12" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- State: Waiting for browser login -->
        <Border x:Name="WaitingPanel" IsVisible="False">
            <StackPanel VerticalAlignment="Center" Spacing="8">
                <TextBlock Text="{loc:T AddChar.Waiting}"
                           FontSize="{DynamicResource EveFontTitle}" FontWeight="SemiBold"
                           Foreground="{StaticResource EveWarningYellowBrush}" />
                <TextBlock Text="{loc:T AddChar.WaitingDesc}"
                           FontSize="{DynamicResource EveFontBody}"
                           Foreground="{StaticResource EveTextSecondaryBrush}"
                           TextWrapping="Wrap" />
                <ProgressBar IsIndeterminate="True" Margin="0,8,0,0"
                             Height="3"
                             Foreground="{StaticResource EveAccentPrimaryBrush}" />
                <Button x:Name="CancelWaitingBtn"
                        Content="{loc:T Action.Cancel}"
                        FontSize="{DynamicResource EveFontBody}" Padding="14,6"
                        CornerRadius="12"
                        HorizontalAlignment="Right"
                        Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <!-- State: Success (character auto-imported) -->
        <Border x:Name="SuccessPanel" IsVisible="False">
            <StackPanel VerticalAlignment="Top" Spacing="8">
                <!-- Just-added character -->
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="&#x2713;" FontSize="{DynamicResource EveFontTitle}"
                               Foreground="{StaticResource EveSuccessGreenBrush}"
                               VerticalAlignment="Center" />
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="CharacterNameText"
                                   Text="{loc:T AddChar.CharacterName}"
                                   FontSize="{DynamicResource EveFontTitle}" FontWeight="Bold"
                                   Foreground="{StaticResource EveAccentPrimaryBrush}" />
                        <TextBlock Text="{loc:T AddChar.AddedSuccessfully}"
                                   FontSize="{DynamicResource EveFontBody}"
                                   Foreground="{StaticResource EveSuccessGreenBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Previously added this session -->
                <Border x:Name="PreviousAddsDivider"
                        Height="1" Background="{StaticResource EveBorderBrush}"
                        Margin="0,4" IsVisible="False" />
                <TextBlock x:Name="PreviousAddsLabel"
                           Text="{loc:T AddChar.AddedEarlier}"
                           FontSize="{DynamicResource EveFontSmall}"
                           Foreground="{StaticResource EveTextDisabledBrush}"
                           IsVisible="False" />
                <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PreviousAddsList" Spacing="2" />
                </ScrollViewer>

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0"
                            HorizontalAlignment="Right">
                    <Button x:Name="AddAnotherBtn"
                            Content="{loc:T AddChar.AddAnother}"
                            FontSize="{DynamicResource EveFontBody}" Padding="14,6"
                            CornerRadius="12"
                            Foreground="{StaticResource EveAccentPrimaryBrush}" />
                    <Button x:Name="DoneBtn"
                            Content="{loc:T PlanEditor.Done}"
                            FontSize="{DynamicResource EveFontBody}" Padding="14,6"
                            CornerRadius="12" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- State: Error -->
        <Border x:Name="ErrorPanel" IsVisible="False">
            <StackPanel VerticalAlignment="Center" Spacing="8">
                <TextBlock Text="{loc:T AddChar.AuthFailed}"
                           FontSize="{DynamicResource EveFontTitle}" FontWeight="SemiBold"
                           Foreground="{StaticResource EveErrorRedBrush}" />
                <TextBlock x:Name="ErrorMessageText"
                           Text="{loc:T AddChar.ErrorOccurred}"
                           FontSize="{DynamicResource EveFontBody}"
                           Foreground="{StaticResource EveTextSecondaryBrush}"
                           TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0"
                            HorizontalAlignment="Right">
                    <Button x:Name="TryAgainBtn"
                            Content="{loc:T AddChar.TryAgain}"
                            FontSize="{DynamicResource EveFontBody}" Padding="14,6"
                            CornerRadius="12" />
                    <Button x:Name="CancelErrorBtn"
                            Content="{loc:T Action.Cancel}"
                            FontSize="{DynamicResource EveFontBody}" Padding="14,6"
                            CornerRadius="12" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
