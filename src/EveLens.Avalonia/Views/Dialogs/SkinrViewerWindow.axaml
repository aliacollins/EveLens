<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:EveLens.Avalonia.Markup"
        x:Class="EveLens.Avalonia.Views.Dialogs.SkinrViewerWindow"
        Title="{loc:T Skinr.Title}"
        Width="1360" Height="860"
        WindowStartupLocation="CenterOwner"
        Icon="avares://EveLens/Properties/EveLens.ico"
        Background="#0C0E15"
        CanResize="True">

    <!-- SKINR Hub: a deliberate sub-brand inside EveLens. The violet accent and the
         near-black navy are local to this window on purpose - the Hub is the app's
         creative-marketplace space and reads as its own room, while fonts stay on the
         shared DynamicResource tiers so the global font scale still applies. -->
    <Window.Resources>
        <SolidColorBrush x:Key="SkinrBgBrush" Color="#0C0E15" />
        <SolidColorBrush x:Key="SkinrRailBrush" Color="#090B11" />
        <SolidColorBrush x:Key="SkinrPanelBrush" Color="#131623" />
        <SolidColorBrush x:Key="SkinrPillBrush" Color="#1A1D2B" />
        <SolidColorBrush x:Key="SkinrAccentBrush" Color="#8B7DF2" />
        <SolidColorBrush x:Key="SkinrAccentDimBrush" Color="#4A4380" />
        <SolidColorBrush x:Key="SkinrTextBrush" Color="#F2F3F8" />
        <SolidColorBrush x:Key="SkinrTextSecBrush" Color="#9CA1B4" />
        <SolidColorBrush x:Key="SkinrTextDimBrush" Color="#5E6376" />
        <SolidColorBrush x:Key="SkinrTierBrush" Color="#E8B54D" />
        <SolidColorBrush x:Key="SkinrBorderBrush" Color="#232738" />
    </Window.Resources>

    <Window.Styles>
        <!-- Loading pulse for carousel tiles still waiting on their captured thumbnail. -->
        <Style Selector="TextBlock.shimmer">
            <Style.Animations>
                <Animation Duration="0:0:1.6" IterationCount="INFINITE">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.30" /></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.85" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.30" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="Auto,*">

        <!-- ===== Left rail ===== -->
        <Border x:Name="LeftRail" Grid.Column="0" Width="64"
                Background="{StaticResource SkinrRailBrush}"
                BorderBrush="{StaticResource SkinrBorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="✦" Margin="0,18,0,26"
                           FontSize="{DynamicResource EveFontTitle}"
                           Foreground="{StaticResource SkinrAccentBrush}"
                           HorizontalAlignment="Center" />
                <StackPanel Spacing="4">
                    <Border x:Name="RailCollection" Background="{StaticResource SkinrPillBrush}"
                            CornerRadius="10" Margin="8,0" Padding="0,10"
                            Cursor="Hand" PointerPressed="OnRailCollection">
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="RailCollectionGlyph" Text="❖"
                                       HorizontalAlignment="Center"
                                       FontSize="{DynamicResource EveFontHeading}"
                                       Foreground="{StaticResource SkinrAccentBrush}" />
                            <TextBlock Text="{loc:T Skinr.RailCollection}"
                                       HorizontalAlignment="Center"
                                       FontSize="{DynamicResource EveFontTiny}"
                                       Foreground="{StaticResource SkinrTextSecBrush}" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="RailHub" Margin="8,0" Padding="0,10" CornerRadius="10"
                            Cursor="Hand" PointerPressed="OnRailHub"
                            ToolTip.Tip="{loc:T Skinr.HubTitle}">
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="RailHubGlyph" Text="◈" HorizontalAlignment="Center"
                                       FontSize="{DynamicResource EveFontHeading}"
                                       Foreground="{StaticResource SkinrTextDimBrush}" />
                            <TextBlock Text="{loc:T Skinr.RailHub}"
                                       HorizontalAlignment="Center"
                                       FontSize="{DynamicResource EveFontTiny}"
                                       Foreground="{StaticResource SkinrTextDimBrush}" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="RailGarage" Margin="8,0" Padding="0,10" CornerRadius="10"
                            Cursor="Hand" PointerPressed="OnRailGarage"
                            ToolTip.Tip="{loc:T Skinr.GarageTitle}">
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="RailGarageGlyph" Text="⬢"
                                       HorizontalAlignment="Center"
                                       FontSize="{DynamicResource EveFontHeading}"
                                       Foreground="{StaticResource SkinrTextDimBrush}" />
                            <TextBlock Text="{loc:T Skinr.RailGarage}"
                                       HorizontalAlignment="Center"
                                       FontSize="{DynamicResource EveFontTiny}"
                                       Foreground="{StaticResource SkinrTextDimBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Stage column ===== -->
        <DockPanel Grid.Column="1">

            <!-- Top bar -->
            <Border x:Name="TopBar" DockPanel.Dock="Top" Height="56"
                    Background="{StaticResource SkinrBgBrush}"
                    BorderBrush="{StaticResource SkinrBorderBrush}" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="18,0">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                                VerticalAlignment="Center">
                        <TextBlock Text="{loc:T Skinr.HubWordmark}" FontWeight="Bold"
                                   FontSize="{DynamicResource EveFontHeading}"
                                   Foreground="{StaticResource SkinrTextBrush}" />
                        <TextBlock Text="{loc:T Skinr.HubWordmarkSub}"
                                   FontSize="{DynamicResource EveFontHeading}"
                                   Foreground="{StaticResource SkinrTextDimBrush}" />
                    </StackPanel>

                    <!-- Search pill -->
                    <Border Grid.Column="1" MaxWidth="520" Height="34" Margin="24,0"
                            Background="{StaticResource SkinrPillBrush}" CornerRadius="17"
                            VerticalAlignment="Center">
                        <DockPanel Margin="14,0">
                            <TextBlock DockPanel.Dock="Left" Text="⌕" VerticalAlignment="Center"
                                       FontSize="{DynamicResource EveFontSubheading}"
                                       Foreground="{StaticResource SkinrTextDimBrush}"
                                       Margin="0,0,8,0" />
                            <TextBox x:Name="SearchBox" Background="Transparent"
                                     BorderThickness="0" VerticalContentAlignment="Center"
                                     FontSize="{DynamicResource EveFontBody}"
                                     Foreground="{StaticResource SkinrTextBrush}"
                                     Watermark="{loc:T Skinr.SearchPlaceholder}"
                                     TextChanged="OnSearchChanged" />
                        </DockPanel>
                    </Border>

                    <!-- Character picker -->
                    <ComboBox Grid.Column="2" x:Name="CharacterCombo" MinWidth="180"
                              VerticalAlignment="Center"
                              FontSize="{DynamicResource EveFontBody}"
                              SelectionChanged="OnCharacterChanged" />
                </Grid>
            </Border>

            <!-- ===== The stage: full-bleed render, chrome floating over it ===== -->
            <Panel>
                <!-- Render surface fills the stage -->
                <Panel x:Name="RenderSurface"
                       SizeChanged="OnRenderSurfaceSizeChanged"
                       PointerPressed="OnRenderPointerPressed"
                       PointerMoved="OnRenderPointerMoved"
                       PointerReleased="OnRenderPointerReleased"
                       PointerWheelChanged="OnRenderPointerWheel"
                       DoubleTapped="OnRenderDoubleTapped"
                       Background="{StaticResource SkinrBgBrush}">
                    <Image x:Name="RenderImage" IsVisible="False" Stretch="Uniform"
                           RenderOptions.BitmapInterpolationMode="HighQuality">
                        <Image.Transitions>
                            <Transitions>
                                <!-- Design swaps dim the old ship and fade the new one up;
                                     during a build this reads as a crossfade instead of a
                                     stale frame that suddenly pops. -->
                                <DoubleTransition Property="Opacity" Duration="0:0:0.28" />
                            </Transitions>
                        </Image.Transitions>
                    </Image>
                </Panel>

                <!-- Center state overlays (placeholder / scope / loading / error) -->
                <StackPanel x:Name="RenderPlaceholder" VerticalAlignment="Center"
                            HorizontalAlignment="Center" Spacing="8" MaxWidth="480"
                            IsHitTestVisible="False">
                    <TextBlock x:Name="RenderTitle" Text="{loc:T Skinr.RenderPlaceholderTitle}"
                               FontSize="{DynamicResource EveFontTitle}"
                               Foreground="{StaticResource SkinrTextDimBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="RenderDesc" Text="{loc:T Skinr.RenderPlaceholderDesc}"
                               FontSize="{DynamicResource EveFontSmall}"
                               Foreground="{StaticResource SkinrTextDimBrush}"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel x:Name="ScopeMissingPanel" IsVisible="False" Spacing="8"
                            VerticalAlignment="Center" HorizontalAlignment="Center"
                            MaxWidth="440">
                    <TextBlock Text="{loc:T Skinr.ScopeMissingTitle}"
                               FontSize="{DynamicResource EveFontSubheading}"
                               Foreground="{StaticResource EveWarningYellowBrush}"
                               TextWrapping="Wrap" HorizontalAlignment="Center" />
                    <TextBlock Text="{loc:T Skinr.ScopeMissingDesc}"
                               FontSize="{DynamicResource EveFontSmall}"
                               Foreground="{StaticResource SkinrTextSecBrush}"
                               TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="LoadingText" IsVisible="False" Text="{loc:T Skinr.Loading}"
                           FontSize="{DynamicResource EveFontBody}"
                           Foreground="{StaticResource SkinrTextSecBrush}"
                           VerticalAlignment="Center" HorizontalAlignment="Center" />
                <TextBlock x:Name="ErrorText" IsVisible="False"
                           FontSize="{DynamicResource EveFontBody}"
                           Foreground="{StaticResource EveErrorRedBrush}"
                           TextWrapping="Wrap" MaxWidth="480"
                           VerticalAlignment="Center" HorizontalAlignment="Center" />

                <!-- Hull identity: the name alone, centered — ship type, description and
                     every other detail live in the right-hand panel by request. -->
                <TextBlock x:Name="HullNameText" IsVisible="False" FontWeight="Bold"
                           Margin="0,18,0,0" HorizontalAlignment="Center"
                           VerticalAlignment="Top" IsHitTestVisible="False"
                           Foreground="{StaticResource SkinrTextBrush}" />

                <!-- Hub detail mode: a market card opened this design — the way back to
                     the discovery grid, pinned over the stage's top-left. -->
                <Button x:Name="MarketBackButton" IsVisible="False"
                        Content="{loc:T Skinr.HubBack}" Padding="12,5" CornerRadius="14"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="20,16,0,0"
                        Background="{StaticResource SkinrPillBrush}"
                        Foreground="{StaticResource SkinrTextBrush}"
                        FontSize="{DynamicResource EveFontSmall}"
                        Click="OnMarketBack" />

                <!-- Stage buttons, top-right: photo mode beside render settings -->
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"
                            VerticalAlignment="Top" Margin="0,16,20,0">
                    <Button x:Name="PhotoButton" Padding="10,6" CornerRadius="14"
                            Background="{StaticResource SkinrPillBrush}"
                            Foreground="{StaticResource SkinrTextSecBrush}"
                            FontSize="{DynamicResource EveFontSmall}"
                            ToolTip.Tip="{loc:T Skinr.PhotoMode}"
                            Click="OnPhotoModeToggle" Content="📷" />
                    <Button x:Name="SettingsButton" Padding="10,6" CornerRadius="14"
                            Background="{StaticResource SkinrPillBrush}"
                            Foreground="{StaticResource SkinrTextSecBrush}"
                            FontSize="{DynamicResource EveFontSmall}"
                            ToolTip.Tip="{loc:T Skinr.RenderSettings}"
                            Content="⚙">
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel Spacing="8" MinWidth="240">
                                    <TextBlock Text="{loc:T Skinr.Quality}"
                                               FontSize="{DynamicResource EveFontSmall}"
                                               Foreground="{StaticResource SkinrTextSecBrush}" />
                                    <ComboBox x:Name="QualityCombo" HorizontalAlignment="Stretch"
                                              FontSize="{DynamicResource EveFontSmall}"
                                              SelectionChanged="OnQualityChanged" />
                                    <TextBlock Text="{loc:T Skinr.Resolution}"
                                               FontSize="{DynamicResource EveFontSmall}"
                                               Foreground="{StaticResource SkinrTextSecBrush}" />
                                    <ComboBox x:Name="ResolutionCombo" HorizontalAlignment="Stretch"
                                              FontSize="{DynamicResource EveFontSmall}"
                                              SelectionChanged="OnResolutionChanged" />
                                    <Button Content="{loc:T Skinr.ResetView}" Click="OnResetView"
                                            HorizontalAlignment="Stretch" Padding="10,4"
                                            CornerRadius="12"
                                            FontSize="{DynamicResource EveFontSmall}" />
                                    <CheckBox x:Name="CdnToggle"
                                              Content="{loc:T Skinr.HubCdnToggle}"
                                              FontSize="{DynamicResource EveFontSmall}"
                                              IsCheckedChanged="OnCdnToggled" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <!-- ===== Bottom band, floating over the render on a gradient scrim.
                     Back-to-overlay by request: the docked version protected the hull
                     from overlap but flattened the whole window into page-with-footer.
                     The scrim + a ONE-ROW card keeps the cinematic full-bleed while
                     covering a fraction of what the old stacked card did. ===== -->
                <StackPanel x:Name="BottomBand" VerticalAlignment="Bottom" Spacing="2">
                    <StackPanel.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                            <GradientStop Offset="0" Color="#000C0E15" />
                            <GradientStop Offset="0.45" Color="#C80C0E15" />
                            <GradientStop Offset="1" Color="#F20C0E15" />
                        </LinearGradientBrush>
                    </StackPanel.Background>

                    <!-- Design title card: ONLY the name in the center (by request) —
                         tier, coatings and the rest live in the details panel. Actions
                         and hints sit at the right edge of the same row. -->
                    <Grid x:Name="DesignCard" IsVisible="False" Margin="18,14,18,0">
                        <TextBlock x:Name="DesignNameText" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource SkinrTextBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="12"
                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                            <StackPanel x:Name="HintStrip" IsVisible="False"
                                        Orientation="Horizontal" Spacing="14"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{loc:T Skinr.HintRotate}"
                                           FontSize="{DynamicResource EveFontCaption}"
                                           Foreground="{StaticResource SkinrTextDimBrush}" />
                                <TextBlock Text="{loc:T Skinr.HintZoom}"
                                           FontSize="{DynamicResource EveFontCaption}"
                                           Foreground="{StaticResource SkinrTextDimBrush}" />
                                <TextBlock Text="{loc:T Skinr.HintReset}"
                                           FontSize="{DynamicResource EveFontCaption}"
                                           Foreground="{StaticResource SkinrTextDimBrush}" />
                            </StackPanel>
                            <Button Content="{loc:T Skinr.Compare}" Padding="12,4"
                                    CornerRadius="14" IsEnabled="False"
                                    VerticalAlignment="Center"
                                    ToolTip.Tip="{loc:T Skinr.ComingSoon}"
                                    Background="{StaticResource SkinrAccentDimBrush}"
                                    Foreground="{StaticResource SkinrTextBrush}"
                                    FontSize="{DynamicResource EveFontSmall}" />
                            <Button x:Name="ViewDetailsButton"
                                    Content="{loc:T Skinr.ViewDetails}"
                                    Padding="12,4" CornerRadius="14"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource SkinrPillBrush}"
                                    Foreground="{StaticResource SkinrTextBrush}"
                                    FontSize="{DynamicResource EveFontSmall}"
                                    Click="OnViewDetails" />
                        </StackPanel>
                    </Grid>

                    <!-- Design carousel: the user's COLLECTION, and only that. Hidden in
                         Hub detail mode so market designs never appear to sit among
                         owned ones — the two navigations must not mix. -->
                    <ScrollViewer x:Name="CarouselScroller"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  Margin="18,4,18,0">
                        <StackPanel x:Name="DesignStrip" Orientation="Horizontal" Spacing="8"
                                    Margin="0,2" />
                    </ScrollViewer>

                    <!-- Environment switcher -->
                    <Border HorizontalAlignment="Center"
                            Margin="0,4,0,10" Background="{StaticResource SkinrPillBrush}"
                            CornerRadius="18" Padding="6,4">
                        <StackPanel x:Name="EnvSwitcher" Orientation="Horizontal" Spacing="4" />
                    </Border>
                </StackPanel>

                <!-- Download / render status, unobtrusive -->
                <!-- ===== Details panel, docked right over the stage: hull stats from the
                     SDE, the design's attributes, share + favorite. The mock this follows
                     is a label/value ledger — every row is a Grid of dim label and
                     right-aligned value, sections split by hairlines. ===== -->
                <Border x:Name="DetailsPanel" IsVisible="False" Width="272"
                        HorizontalAlignment="Right" VerticalAlignment="Stretch"
                        Background="#F00D0F17"
                        BorderBrush="{StaticResource SkinrBorderBrush}"
                        BorderThickness="1,0,0,0" Padding="18,14">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                            <Button DockPanel.Dock="Right" Content="✕" Padding="6,2"
                                    Background="Transparent"
                                    Foreground="{StaticResource SkinrTextDimBrush}"
                                    FontSize="{DynamicResource EveFontSmall}"
                                    Click="OnDetailsClose" />
                            <TextBlock x:Name="PanelHullName" FontWeight="Bold"
                                       FontSize="{DynamicResource EveFontTitle}"
                                       Foreground="{StaticResource SkinrTextBrush}"
                                       VerticalAlignment="Center" />
                        </DockPanel>

                        <!-- share / favorite pinned to the panel foot -->
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                    Spacing="10" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <Button x:Name="ShareButton" Content="⇪" Padding="10,4"
                                    CornerRadius="12"
                                    Background="{StaticResource SkinrPillBrush}"
                                    Foreground="{StaticResource SkinrTextSecBrush}"
                                    FontSize="{DynamicResource EveFontSmall}"
                                    ToolTip.Tip="{loc:T Skinr.Share}"
                                    Click="OnShare" />
                            <Button x:Name="FavoriteButton" Content="♡" Padding="10,4"
                                    CornerRadius="12"
                                    Background="{StaticResource SkinrPillBrush}"
                                    Foreground="{StaticResource SkinrTextSecBrush}"
                                    FontSize="{DynamicResource EveFontSmall}"
                                    ToolTip.Tip="{loc:T Skinr.Favorite}"
                                    Click="OnFavorite" />
                        </StackPanel>

                        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="0">
                                <TextBlock x:Name="PanelHullSub"
                                           FontSize="{DynamicResource EveFontCaption}"
                                           Foreground="{StaticResource SkinrTextSecBrush}"
                                           Margin="0,0,0,12" />
                                <!-- hull stat rows land here -->
                                <StackPanel x:Name="PanelHullStats" Spacing="9" />
                                <Border Height="1" Margin="0,14"
                                        Background="{StaticResource SkinrBorderBrush}" />
                                <!-- design attribute rows land here -->
                                <StackPanel x:Name="PanelDesignStats" Spacing="9" />
                                <Border Height="1" Margin="0,14"
                                        Background="{StaticResource SkinrBorderBrush}" />
                                <!-- composition rows: coatings, patterns, licenses -->
                                <StackPanel x:Name="PanelCompositionStats" Spacing="9" />
                                <Border Height="1" Margin="0,14"
                                        Background="{StaticResource SkinrBorderBrush}" />
                                <!-- the hull's lore paragraph, displaced from the stage -->
                                <TextBlock x:Name="PanelHullDesc"
                                           FontSize="{DynamicResource EveFontCaption}"
                                           Foreground="{StaticResource SkinrTextDimBrush}"
                                           TextWrapping="Wrap" Margin="0,0,0,10" />
                                <TextBlock x:Name="PanelNotes" IsVisible="False"
                                           FontSize="{DynamicResource EveFontCaption}"
                                           Foreground="{StaticResource EveWarningYellowBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- ===== Paragon Hub discovery pane: covers the stage while browsing.
                     Phase 1 of the marketplace — the public listing feed grouped per
                     design, ship-first filter, cards that open straight into the
                     viewer. Price history and recommendations arrive with the
                     collector phases. ===== -->
                <Border x:Name="MarketPane" IsVisible="False" Background="#FA0C0E15">
                    <DockPanel Margin="26,18,26,12">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                        Spacing="10" VerticalAlignment="Center">
                                <Border Background="{StaticResource SkinrPillBrush}"
                                        CornerRadius="14" Height="30" MinWidth="220">
                                    <DockPanel Margin="12,0">
                                        <TextBlock DockPanel.Dock="Left" Text="⌕"
                                                   VerticalAlignment="Center"
                                                   FontSize="{DynamicResource EveFontBody}"
                                                   Foreground="{StaticResource SkinrTextDimBrush}"
                                                   Margin="0,0,8,0" />
                                        <TextBox x:Name="MarketSearchBox" Background="Transparent"
                                                 BorderThickness="0"
                                                 VerticalContentAlignment="Center"
                                                 FontSize="{DynamicResource EveFontSmall}"
                                                 Foreground="{StaticResource SkinrTextBrush}"
                                                 Watermark="{loc:T Skinr.SearchPlaceholder}"
                                                 TextChanged="OnMarketSearchChanged" />
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel Spacing="3">
                                <TextBlock x:Name="MarketTitle" Text="{loc:T Skinr.HubTitle}"
                                           FontWeight="Bold"
                                           FontSize="{DynamicResource EveFontTitle}"
                                           Foreground="{StaticResource SkinrAccentBrush}" />
                                <TextBlock x:Name="MarketStats"
                                           FontSize="{DynamicResource EveFontCaption}"
                                           Foreground="{StaticResource SkinrTextSecBrush}" />
                            </StackPanel>
                        </DockPanel>
                        <!-- One-time consent for the preview shelf: the app never talks
                             to a non-CCP server without a remembered, revisitable yes. -->
                        <Border x:Name="CdnBanner" DockPanel.Dock="Top" IsVisible="False"
                                Background="{StaticResource SkinrPillBrush}"
                                CornerRadius="10" Padding="14,10" Margin="0,0,0,12">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                            Spacing="8" VerticalAlignment="Center"
                                            Margin="12,0,0,0">
                                    <Button Content="{loc:T Skinr.HubCdnEnable}"
                                            Padding="12,4" CornerRadius="12"
                                            Background="{StaticResource SkinrAccentDimBrush}"
                                            Foreground="{StaticResource SkinrTextBrush}"
                                            FontSize="{DynamicResource EveFontSmall}"
                                            Click="OnCdnEnable" />
                                    <Button Content="{loc:T Skinr.HubCdnNo}"
                                            Padding="12,4" CornerRadius="12"
                                            Background="Transparent"
                                            Foreground="{StaticResource SkinrTextSecBrush}"
                                            FontSize="{DynamicResource EveFontSmall}"
                                            Click="OnCdnDecline" />
                                </StackPanel>
                                <TextBlock Text="{loc:T Skinr.HubCdnAsk}" TextWrapping="Wrap"
                                           VerticalAlignment="Center"
                                           FontSize="{DynamicResource EveFontSmall}"
                                           Foreground="{StaticResource SkinrTextSecBrush}" />
                            </DockPanel>
                        </Border>
                        <TextBlock x:Name="MarketStatus" DockPanel.Dock="Top" IsVisible="False"
                                   Margin="0,30,0,0" HorizontalAlignment="Center"
                                   FontSize="{DynamicResource EveFontBody}"
                                   Foreground="{StaticResource SkinrTextSecBrush}"
                                   TextWrapping="Wrap" />
                        <!-- The market tree: class → faction → ship with design counts,
                             the way EVE's own market browses. Clicking a node scopes
                             the card grid on the right. -->
                        <Border DockPanel.Dock="Left" Width="250" Margin="0,0,16,0"
                                Background="{StaticResource SkinrPanelBrush}"
                                CornerRadius="8"
                                BorderBrush="{StaticResource SkinrBorderBrush}"
                                BorderThickness="1" Padding="4">
                            <TreeView x:Name="MarketTree" Background="Transparent"
                                      FontSize="{DynamicResource EveFontSmall}"
                                      SelectionChanged="OnMarketTreeSelection" />
                        </Border>
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <!-- Class·faction sections, cards sorted ship-then-name. -->
                            <StackPanel x:Name="MarketSections" Spacing="6" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- ===== My Hangar: station-scoped garage. Pick a station holding
                     your ships, pick a hull, stand on the pad with it. ===== -->
                <Border x:Name="GaragePane" IsVisible="False" Background="#FA0C0E15">
                    <DockPanel Margin="26,18,26,12">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                            <ComboBox x:Name="GarageStationCombo" DockPanel.Dock="Right"
                                      MinWidth="340" VerticalAlignment="Center"
                                      FontSize="{DynamicResource EveFontSmall}"
                                      SelectionChanged="OnGarageStationChanged" />
                            <StackPanel Spacing="3">
                                <TextBlock Text="{loc:T Skinr.GarageTitle}" FontWeight="Bold"
                                           FontSize="{DynamicResource EveFontTitle}"
                                           Foreground="{StaticResource SkinrAccentBrush}" />
                                <TextBlock x:Name="GarageStats"
                                           FontSize="{DynamicResource EveFontCaption}"
                                           Foreground="{StaticResource SkinrTextSecBrush}" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock x:Name="GarageStatus" DockPanel.Dock="Top" IsVisible="False"
                                   Margin="0,30,0,0" HorizontalAlignment="Center"
                                   FontSize="{DynamicResource EveFontBody}"
                                   Foreground="{StaticResource SkinrTextSecBrush}" />
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <WrapPanel x:Name="GarageGrid" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Balcony mode: back to the station's ship list. -->
                <Button x:Name="GarageBackButton" IsVisible="False"
                        Content="{loc:T Skinr.GarageBack}" Padding="12,5" CornerRadius="14"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="20,16,0,0"
                        Background="{StaticResource SkinrPillBrush}"
                        Foreground="{StaticResource SkinrTextBrush}"
                        FontSize="{DynamicResource EveFontSmall}"
                        Click="OnGarageBack" />

                <Border x:Name="StatusPill" HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Margin="18,0,0,10" Background="{StaticResource SkinrPillBrush}"
                        CornerRadius="10" Padding="10,4" Opacity="0.9">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock x:Name="RenderStatusText" Text="{loc:T Skinr.StatusIdle}"
                                   FontSize="{DynamicResource EveFontCaption}"
                                   Foreground="{StaticResource SkinrTextDimBrush}"
                                   VerticalAlignment="Center" />
                        <ProgressBar x:Name="DownloadProgress" IsVisible="False" Width="120"
                                     Minimum="0" Maximum="100" Height="6"
                                     VerticalAlignment="Center" />
                        <TextBlock x:Name="SpinCounterText" IsVisible="False"
                                   FontSize="{DynamicResource EveFontCaption}"
                                   Foreground="{StaticResource SkinrAccentBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Panel>
        </DockPanel>
    </Grid>
</Window>
