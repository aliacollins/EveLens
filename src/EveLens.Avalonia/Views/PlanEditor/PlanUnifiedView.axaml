<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:EveLens.Avalonia.Views.PlanEditor"
             xmlns:loc="clr-namespace:EveLens.Avalonia.Markup"
             x:Class="EveLens.Avalonia.Views.PlanEditor.PlanUnifiedView">
    <DockPanel>
        <!-- Toolbar row: the plan's ACTIONS, left-aligned under the tabs where
             the hand already is (they were stranded on the far right). -->
        <Border DockPanel.Dock="Top" Padding="14,6"
                Background="{StaticResource EveBackgroundMediumBrush}">
            <DockPanel>
                <ToggleButton x:Name="SidebarToggle" DockPanel.Dock="Right" Content="☰" IsChecked="True"
                              FontSize="{DynamicResource EveFontSmall}" Padding="6,2" CornerRadius="8"
                              Click="OnSidebarToggle" ToolTip.Tip="{loc:T PlanEditor.ToggleSidebar}" />
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button x:Name="AddSkillsBtn" Content="{loc:T PlanEditor.AddSkills}" FontSize="{DynamicResource EveFontSmall}" Padding="10,3"
                            CornerRadius="8" Click="OnAddSkills" />
                    <Button x:Name="CopyPlanBtn" Content="{loc:T PlanEditor.CopyPlan}" FontSize="{DynamicResource EveFontSmall}" Padding="10,3"
                            CornerRadius="8" Click="OnCopyClick" />
                    <Button x:Name="GroupByAttrBtn" Content="{loc:T Plan.GroupByAttr}" FontSize="{DynamicResource EveFontSmall}" Padding="10,3"
                            CornerRadius="8" Click="OnGroupByAttribute"
                            ToolTip.Tip="{loc:T PlanEditor.GroupByAttrTip}" />
                    <Button x:Name="GroupByPriorityBtn" Content="{loc:T Plan.GroupByPriority}" FontSize="{DynamicResource EveFontSmall}" Padding="10,3"
                            CornerRadius="8" Click="OnGroupByPriority"
                            ToolTip.Tip="{loc:T PlanEditor.GroupByPriorityTip}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Stats band: total time leads (white — green is reserved for the WIN,
             the optimization verdict), then what/when. -->
        <Border DockPanel.Dock="Top" Padding="14,8"
                Background="{StaticResource EveBackgroundMediumBrush}"
                BorderBrush="{StaticResource EveBorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <TextBlock x:Name="TrainingTimeText" FontWeight="Bold"
                           Foreground="{StaticResource EveTextPrimaryBrush}"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="SkillCountText" FontSize="{DynamicResource EveFontBody}"
                           Foreground="{StaticResource EveTextSecondaryBrush}"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="FinishDateText" FontSize="{DynamicResource EveFontBody}"
                           Foreground="{StaticResource EveTextSecondaryBrush}"
                           VerticalAlignment="Center" />
                <!-- Live optimization verdict, with the clone it was computed for.
                     Click opens the optimizer. Async off the UI thread. -->
                <Button x:Name="OptimizedBadge" IsVisible="False"
                        Background="Transparent" BorderThickness="0"
                        Padding="6,2" CornerRadius="8"
                        FontSize="{DynamicResource EveFontBody}"
                        Click="OnOptimizedBadgeClick" />
                <TextBlock x:Name="InjectorText" FontSize="{DynamicResource EveFontSmall}"
                           Foreground="{StaticResource EveSuccessGreenBrush}"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="TotalSpText" FontSize="{DynamicResource EveFontSmall}"
                           Foreground="{StaticResource EveTextSecondaryBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Main content: skill list + gap + left-sticking sidebar -->
        <Grid ColumnDefinitions="*,8,Auto">
            <!-- Column 0: Skill list area -->
            <DockPanel Grid.Column="0">
                <!-- Plan composition strip (6px, proportional segments) -->
                <Border DockPanel.Dock="Top" Height="6"
                        Background="{StaticResource EveBackgroundDarkestBrush}"
                        ToolTip.Tip="{loc:T PlanEditor.PlanComposition}">
                    <StackPanel x:Name="TimelineBar" Orientation="Horizontal" />
                </Border>

                <!-- Queue list with chain ribbons, time bars, headers, and drag reorder -->
                <local:PlanQueueListControl x:Name="QueueListControl"
                                            Background="{StaticResource EveBackgroundDarkBrush}" />
            </DockPanel>

            <!-- Column 1: Gap (space between list and sidebar) -->

            <!-- Column 2: Left-sticking sidebar -->
            <Border x:Name="SidebarBorder" Grid.Column="2" Width="320"
                    HorizontalAlignment="Left"
                    Background="{StaticResource EveBackgroundMediumBrush}"
                    BorderBrush="{StaticResource EveBorderBrush}" BorderThickness="1,0,0,0">
                <Panel>
                    <!-- Expanded sidebar -->
                    <DockPanel x:Name="SidebarExpanded">
                        <!-- Sidebar tab header -->
                        <Border DockPanel.Dock="Top" Padding="8,6"
                                BorderBrush="{StaticResource EveBorderBrush}" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <ToggleButton x:Name="SidebarPlanTab" Content="{loc:T Sidebar.Plan}" IsChecked="True"
                                              FontSize="{DynamicResource EveFontSmall}" Padding="8,3" CornerRadius="10"
                                              Click="OnSidebarTabClick" />
                                <ToggleButton x:Name="SidebarAddTab" Content="{loc:T Sidebar.Add}"
                                              FontSize="{DynamicResource EveFontSmall}" Padding="8,3" CornerRadius="10"
                                              Click="OnSidebarTabClick" />
                            </StackPanel>
                        </Border>

                        <!-- Sidebar content (swapped programmatically) -->
                        <ScrollViewer>
                            <StackPanel x:Name="SidebarContent" Margin="10,8" Spacing="10" />
                        </ScrollViewer>
                    </DockPanel>

                    <!-- Collapsed sidebar (icon strip) -->
                    <StackPanel x:Name="SidebarCollapsed" IsVisible="False"
                                Spacing="2" Margin="2,8,2,0">
                        <Button x:Name="CollapsedPlanBtn" Content="Σ" FontSize="{DynamicResource EveFontTitle}"
                                Width="32" Height="32" Padding="0"
                                CornerRadius="6" HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                ToolTip.Tip="{loc:T Sidebar.Plan}" Click="OnCollapsedSidebarClick" Tag="Plan" />
                        <Button x:Name="CollapsedAddBtn" Content="+" FontSize="{DynamicResource EveFontTitle}"
                                Width="32" Height="32" Padding="0"
                                CornerRadius="6" HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                ToolTip.Tip="{loc:T Sidebar.AddSkills}" Click="OnCollapsedSidebarClick" Tag="Add" />
                    </StackPanel>
                </Panel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
